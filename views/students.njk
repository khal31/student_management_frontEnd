<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Students</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #f5f5f5;
        }

        h1 {
            margin-bottom: 24px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        th,
        td {
            padding: 14px;
            border: 1px solid #ddd;
            text-align: left;
            vertical-align: top;
        }

        th {
            background-color: #333;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .subject-list {
            margin: 0;
            padding-left: 20px;
        }

        .no-subjects {
            color: #777;
            font-style: italic;
        }
    </style>
</head>

<body>

    <h1>Students</h1>

    <table>

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Percentage</th>
                <th>Branch</th>
                <th>Subjects</th>
            </tr>
        </thead>

        <tbody>

            {% for student in students %}

                <tr>
                    <td>
                        {{ student.rollNo }}
                    </td>

                    <td>
                        {{ student.name }}
                    </td>

                    <td>
                        {{ student.percentage }}%
                    </td>

                    <td>
                        {{ student.branch }}
                    </td>

                    <td>

                        {% if student.subjects.length > 0 %}

                            <ul class="subject-list">

                                {% for studentSubject in student.subjects %}

                                    <li>
                                        {{ studentSubject.subject.name }}
                                        -
                                        Grade: {{ studentSubject.grade }}
                                    </li>

                                {% endfor %}

                            </ul>

                        {% else %}

                            <span class="no-subjects">
                                No subjects
                            </span>

                        {% endif %}

                    </td>
                </tr>

            {% endfor %}

        </tbody>

    </table>

</body>
</html>